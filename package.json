{
  "name": "typebench",
  "version": "1.0.0",
  "description": "TypeScript-specific benchmark for AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "typebench": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx cli/index.ts",
    "test": "find dataset evaluator harness scoring -type f -name 'test-*.ts' -print0 | xargs -0 -n1 tsx",
    "typecheck": "tsc --noEmit",
    "prepare-dataset": "tsx scripts/expand-dataset.ts",
    "validate": "tsx scripts/validate-dataset.ts",
    "release": "tsx scripts/prepare-release.ts",
    "ingest": "tsx scripts/ingest-repos.ts",
    "discover": "tsx scripts/discover-candidates.ts",
    "generate-tasks": "tsx scripts/generate-tasks.ts",
    "run-benchmark": "tsx cli/run.ts",
    "evaluate": "tsx cli/eval.ts",
    "leaderboard": "tsx cli/leaderboard.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^7.0.1",
    "semver": "^7.5.4",
    "simple-git": "^3.22.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}