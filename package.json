{
  "name": "typebench",
  "version": "1.0.0",
  "description": "TypeScript-specific benchmark for AI coding agents",
  "type": "module",
  "main": "./cli/index.js",
  "bin": {
    "typebench": "./cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "TYPEBENCH_SOURCE=1 node cli/index.js",
    "test": "find dataset evaluator harness scoring -type f -name 'test-*.ts' -print0 | xargs -0 -n1 tsx",
    "typecheck": "tsc --noEmit",
    "typebench": "node cli/index.js",
    "prepare-dataset": "tsx dataset/build-dataset.ts",
    "validate": "tsx dataset/validate-readiness.ts",
    "release": "tsx dataset/release-dataset.ts",
    "generate-tasks": "tsx scripts/generate-tasks.ts",
    "run-benchmark": "node cli/index.js run",
    "evaluate": "node cli/index.js evaluate",
    "leaderboard": "node cli/index.js leaderboard"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^7.0.1",
    "semver": "^7.5.4",
    "simple-git": "^3.22.0",
    "tsx": "^4.7.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}