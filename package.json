{
  "name": "typebench",
  "version": "0.1.0",
  "description": "Benchmark for evaluating AI coding agents on real TypeScript engineering tasks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "typebench": "tsx harness/src/index.ts",
    "generate:tasks": "tsx scripts/generate-tasks.ts",
    "leaderboard:generate": "tsx results/leaderboard/generate.ts",
    "lint": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "workspaces": [
    "harness"
  ],
  "keywords": [
    "benchmark",
    "typescript",
    "ai-agents",
    "evaluation",
    "llm",
    "coding-benchmark"
  ],
  "author": "Typebench Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "simple-git": "^3.36.0"
  }
}
